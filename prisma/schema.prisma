generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(STAFF)
  avatar    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  auditLogs AuditLog[]
  // Per-user feature access. Empty means "use the defaults for this role"
  // (see src/lib/permissions.ts) — so existing users keep working untouched.
  permissions String[] @default([])

  @@index([email])
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

model Property {
  id          String         @id @default(cuid())
  name        String
  description String?
  type        String         @default("room")
  capacity    Int            @default(2)
  baseRate    Float
  status      PropertyStatus @default(ACTIVE)
  amenities   String[]
  images      String[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  bookings    Booking[]

  @@index([status])
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

model Booking {
  id           String        @id @default(cuid())
  // Identity now lives on Guest. These stay as the display/fallback copy so
  // every existing booking, list and chart keeps working before the backfill.
  guestName    String
  guestEmail   String?
  guestPhone   String?
  guestId      String?
  guest        Guest?        @relation(fields: [guestId], references: [id], onDelete: SetNull)
  checkIn      DateTime
  checkOut     DateTime
  nights       Int
  rate         Float
  cleaningFee  Float         @default(0)
  platformFee  Float         @default(0)
  totalAmount  Float
  netAmount    Float
  paidAmount   Float         @default(0)
  platform        Platform      @default(AIRBNB)
  status          BookingStatus @default(CONFIRMED)
  notes           String?
  miscCharges     Float         @default(0)
  miscDescription String?
  propertyId      String
  property        Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  income          Income?
  reminderAt      DateTime?
  reminderNote    String?
  documents       Document[]

  // Hotel Eye / Guest identity fields
  guestCnic            String?
  guestFatherName      String?
  guestGender          String?
  guestAddress         String?
  passportNumber       String?
  nationality          String?
  passportExpiry       String?
  guestProvince        String?
  guestDistrict        String?
  tempAddress          String?
  tempProvince         String?
  tempDistrict         String?
  purposeOfVisit       String?
  accompanyingMale     Int?     @default(0)
  accompanyingFemale   Int?     @default(0)
  accompanyingChildren Int?     @default(0)
  roomNumber           String?

  // Hotel Eye reference/dealer
  refName              String?
  refFatherName        String?
  refBusiness          String?
  refAddress           String?
  refCell              String?
  refVerified          Boolean? @default(false)

  // NOT_ENTERED | QUEUED | ENTERED | FAILED
  hotelEyeStatus  String    @default("NOT_ENTERED")
  // When the portal accepted the entry — the proof an inspector asks for.
  // Without it there is evidence that a guest was filed but not when.
  hotelEyeFiledAt DateTime?
  // Last failure reason from the filing worker. This previously only reached
  // HotelEyeJob.error, a table the app never reads, so a failed filing was
  // indistinguishable from one nobody had attempted.
  hotelEyeError   String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([propertyId])
  @@index([checkIn, checkOut])
  @@index([status])
  @@index([platform])
  @@index([guestId])
}

// A person, kept once and reused across stays. Scanning a repeat guest's card
// every visit was the reason the same identity got retyped (and mistyped).
model Guest {
  id             String    @id @default(cuid())
  name           String
  email          String?
  phone          String?

  // Pakistani CNIC. Unique so one person cannot end up with two profiles —
  // Postgres allows many NULLs, so passport-only guests do not collide.
  cnic           String?   @unique
  fatherName     String?
  gender         String?
  address        String?
  province       String?
  district       String?

  passportNumber String?   @unique
  nationality    String?
  passportExpiry String?

  notes          String?
  bookings       Booking[]
  // Scanned CNIC / passport images, kept with the person
  documents      Document[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([name])
}

enum Platform {
  AIRBNB
  DIRECT
  BOOKING_COM
  VRBO
  OTHER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

model Income {
  id          String   @id @default(cuid())
  bookingId   String   @unique
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  grossAmount Float
  platformFee Float    @default(0)
  cleaningFee Float    @default(0)
  netAmount   Float
  receivedAt  DateTime
  month       Int
  year        Int
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([year, month])
  @@index([receivedAt])
}

model Expense {
  id              String          @id @default(cuid())
  date            DateTime
  category        ExpenseCategory
  subcategory     String?
  description     String
  amount          Float
  paidAmount      Float           @default(0)
  vendor          String?
  notes           String?
  month           Int
  year            Int
  receiptData     String?         @db.Text
  receiptMimeType String?
  receiptName     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([year, month])
  @@index([category])
  @@index([date])
}

enum ExpenseCategory {
  CLEANING
  MAINTENANCE
  UTILITIES
  SUPPLIES
  MARKETING
  PLATFORM_FEES
  INSURANCE
  TAXES
  SALARY
  REPAIRS
  OTHER
}

model Payout {
  id            String       @id @default(cuid())
  recipientName String
  amount        Float
  paidAmount    Float        @default(0)
  date          DateTime
  type          PayoutType
  description   String?
  status        PayoutStatus @default(PENDING)
  notes         String?
  month         Int
  year          Int
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status])
  @@index([year, month])
}

enum PayoutType {
  SALARY
  BONUS
  COMMISSION
  REIMBURSEMENT
  CLEANING_FEE
  FOOD_ALLOWANCE
  OTHER
}

enum PayoutStatus {
  PENDING
  PAID
  CANCELLED
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model Backup {
  id          String   @id @default(cuid())
  label       String
  recordCount Int      @default(0)
  createdBy   String?
  data        Json
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model HotelEyeJob {
  id        String   @id @default(cuid())
  status    String   @default("pending") // pending | processing | done | failed
  payload   Json
  bookingId String?
  error     String?
  // How many times a worker has claimed this job. The queue is oldest-first, so
  // a job that kills the worker every time would otherwise be requeued forever
  // and block everything behind it.
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Document {
  id        String   @id @default(cuid())
  // A document hangs off a booking (a stay's paperwork) or off a guest (their
  // scanned card, which belongs to the person rather than to one visit).
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  guestId   String?
  guest     Guest?   @relation(fields: [guestId], references: [id], onDelete: Cascade)
  name      String
  mimeType  String
  size      Int
  data      String   @db.Text
  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([guestId])
}
