# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/property_manager?schema=public"
# Non-pooled URL. prisma/schema.prisma declares directUrl, so migrate/db push
# fail without it even locally. Same value as DATABASE_URL for a plain Postgres.
DIRECT_URL="postgresql://postgres:password@localhost:5432/property_manager?schema=public"

# Auth
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="your-jwt-secret-change-in-production"

# Document scanners (CNIC, passport, expense receipts).
# Without it /api/cnic-extract, /api/passport-extract and /api/expense-extract
# all fail — the scanner buttons are dead but the rest of the app looks fine.
ANTHROPIC_API_KEY="sk-ant-..."

# Shared secret between this app and the Hotel Eye filing worker (Flask, :5000).
# The worker sends it as the x-hotel-eye-secret header when polling for jobs.
# /api/hotel-eye/poll fails CLOSED: leave this unset and every poll gets a 403,
# so queued filings sit in HotelEyeJob forever and no guest is ever filed.
# Must match the worker's copy exactly. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
HOTEL_EYE_SECRET="change-me-and-set-the-same-value-in-the-filing-worker"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="PropManager"

# Seeding: users only by default. Set true for demo properties/bookings.
SEED_DEMO_DATA="false"

# Optional: Email (for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@propmanager.com"
